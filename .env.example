# Copy this file to .env on a trusted computer.
# NEVER commit .env or share your secret key.
SOLANA_RPC_URL=https://api.devnet.solana.com
# JSON array exported by a Solana wallet/keypair tool. Devnet wallet only.
DEVNET_KEYPAIR=
# Optional: set this to a known SPLD mint address for verification.
SPLD_MINT_ADDRESS=
